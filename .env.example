# TravioGhana Admin Dashboard — Environment Variables
# Copy this file to .env and fill in the values

# Backend API URL — must be the Ghana API host. The dashboard uses httpOnly
# cookies for auth, so pointing at a different registrable domain makes the
# Google callback's cookie cross-site (and its Domain was set for Africa),
# which browsers drop and turn into an immediate 401 after sign-in.
VITE_API_URL=https://api.travioghana.com/api

# Firebase client configuration
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# Auth.js-compatible backend configuration
VITE_AUTH_API_BASE_URL=https://api.travioghana.com/api

# Google OAuth Client ID (for One Tap login)
VITE_GOOGLE_CLIENT_ID=your-google-client-id

# Travio Ghana API
VITE_GHANA_API_BASE_URL=https://api.travioghana.com/api/travioghana

# Travio Ghana
VITE_TRAVIO_GHANA_URL=https://travioghana.com
